{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vc-governance:markdown-metadata:1.0.0",
  "title": "Markdown metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata-version", "title", "description", "document-type", "repository", "language", "updated"],
  "properties": {
    "metadata-version": {"type": "string", "const": "1.0.0"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "minLength": 1, "maxLength": 240},
    "document-type": {
      "type": "string",
      "enum": ["overview", "agent-instructions", "index", "governance-policy", "owner-decision", "process", "standard", "artifact-contract", "template", "implementation-constraint", "research", "reference"]
    },
    "repository": {"type": "string", "const": "vc.Governance"},
    "language": {"type": "string", "const": "Standard Technical English"},
    "updated": {"type": "string", "format": "date"}
  }
}
